# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings -> API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: used only by scripts/seed-demo.ts, never by the app or browser
SUPABASE_SECRET_KEY=

# Gemini: Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=

# Google Maps Platform: two keys
# Server key: Places API (New) + Routes API only
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API only, restricted to your site addresses
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
